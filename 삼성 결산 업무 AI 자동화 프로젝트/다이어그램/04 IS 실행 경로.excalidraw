    {
      "id": "04 IS 실행 경로-34",
      "type": "text",
      "x": 50,
      "y": 745,
      "width": 1500,
      "height": 55,
      "angle": 0,
      "strokeColor": "#253247",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
